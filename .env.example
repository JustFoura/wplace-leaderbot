# Copy this file to .env and fill in the values.
#   cp .env.example .env

# Discord bot token (Discord Developer Portal -> Your App -> Bot -> Reset Token).
DISCORD_TOKEN=

# Optional. Default daily report channel. You can set or change it at any
# time with /channel-set in Discord, which overrides this value.
DISCORD_CHANNEL_ID=

# Optional: your Wplace "j" login cookie, pasted verbatim from the browser.
# Leave empty to run fully anonymously; collection currently works without it,
# but having it lets the bot identify your alliance by ID and resolve zones
# from alliance activity if public data ever stops covering them.
WPLACE_J=

# Optional: comma or space separated server IDs for instant slash-command
# availability while developing. The bot can serve any number of servers;
# without these IDs, commands are synced globally and may take up to an hour
# to appear after the first launch.
DISCORD_GUILD_IDS=

# Legacy single-server spelling. DISCORD_GUILD_IDS takes precedence.
DISCORD_GUILD_ID=

# Optional: only set this if Wplace enables Cloudflare "Under Attack" mode.
# Paste the cf_clearance cookie from the same browser session, and set
# WPLACE_USER_AGENT to that browser's exact user agent string.
WPLACE_CF_CLEARANCE=
WPLACE_USER_AGENT=
